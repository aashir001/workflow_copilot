# Planner: local (default, offline, no API key) | anthropic | openai_compat
COPILOT_PLANNER=local

# --- anthropic planner (real LLM tool-calling) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- openai_compat planner (free/local: Ollama, llama.cpp server, vLLM, ...) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# OPENAI_API_KEY=ollama

# Mock-service behaviour
# COPILOT_FAILURE_RATE=0.0     # probability a mock service call fails transiently
# COPILOT_DB=copilot.db        # SQLite file for requests, approvals and audit log
